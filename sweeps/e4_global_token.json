{
  "name": "e4_global_token",
  "_purpose": "Phase 1d: residual global-context token (mean-pooled summary of all 49 bridge-input positions, bypassing the learned K-way pooling, appended as an extra token). Primary-only, no baseline mirror. Base = final_retrain_v3 winning config.",
  "base": {
    "model": "primary",
    "processed-dir": "outputs/processed_full",
    "features-dir": "outputs/features_full",
    "epochs": 30,
    "batch-size": 128,
    "num-workers": 0,
    "warmup-steps": 200,
    "early-stop-patience": 5,
    "min-epochs": 8,
    "save-best": true,
    "select-metric": "val_loss",
    "skip-test": true,
    "seed": 360,
    "dropout": 0.15,
    "weight-decay": 0.01,
    "n-compressed-tokens": 16,
    "pool": "last",
    "lr": 0.001,
    "word-dropout-prob": 0.15,
    "token-order": "question_first"
  },
  "runs": [
    {"run-name": "e4_global_token_off"},
    {"run-name": "e4_global_token_on", "bridge-global-token": true}
  ]
}
