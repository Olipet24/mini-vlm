{
  "name": "e6_glove_primary",
  "_purpose": "Phase 1f, primary side: GloVe-derived word-embedding init (98.9% tokenizer-vocab coverage) at 3 init scales, vs scratch control. Shared/fairness lever -- see e6_glove_baseline.json for the mirrored baseline sweep.",
  "base": {
    "model": "primary",
    "processed-dir": "outputs/processed_full",
    "features-dir": "outputs/features_full",
    "epochs": 30,
    "batch-size": 128,
    "num-workers": 0,
    "warmup-steps": 200,
    "early-stop-patience": 5,
    "min-epochs": 8,
    "save-best": true,
    "select-metric": "val_loss",
    "skip-test": true,
    "seed": 360,
    "dropout": 0.15,
    "weight-decay": 0.01,
    "n-compressed-tokens": 16,
    "pool": "last",
    "lr": 0.001,
    "word-dropout-prob": 0.15,
    "token-order": "question_first"
  },
  "runs": [
    {"run-name": "e6_primary_glove_s0.02", "embed-init": "glove", "glove-embed-path": "outputs/embeddings/glove_d128_processed_full.pt"},
    {"run-name": "e6_primary_glove_s0.1", "embed-init": "glove", "glove-embed-path": "outputs/embeddings/glove_d128_processed_full_scale0.1.pt"},
    {"run-name": "e6_primary_glove_s0.5", "embed-init": "glove", "glove-embed-path": "outputs/embeddings/glove_d128_processed_full_scale0.5.pt"}
  ]
}
