{
  "name": "e2_reweight_baseline",
  "_purpose": "Phase 1b, baseline side (fairness mirror of e2_reweight_primary.json): reweighted training sampling toward 'other'. Base = baseline's own tuned config (dropout/wd defaults, lr=1e-3 per final_retrain_v3.json's baseline entry).",
  "base": {
    "model": "baseline",
    "processed-dir": "outputs/processed_full",
    "features-dir": "outputs/features_full",
    "epochs": 30,
    "batch-size": 128,
    "num-workers": 0,
    "warmup-steps": 200,
    "early-stop-patience": 5,
    "min-epochs": 8,
    "save-best": true,
    "select-metric": "val_loss",
    "skip-test": true,
    "seed": 360,
    "lr": 0.001
  },
  "runs": [
    {"run-name": "e2_baseline_reweight_1.5", "type-sample-weight": "yes/no:1.0,other:1.5,number:1.0"},
    {"run-name": "e2_baseline_reweight_2.0", "type-sample-weight": "yes/no:1.0,other:2.0,number:1.0"}
  ]
}
