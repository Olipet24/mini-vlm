{
  "name": "e5_adapter_primary",
  "_purpose": "Phase 1e, primary side: cache-compatible feature adapter (proxy for fine-tuning the frozen vision encoder without breaking the offline-cache design). Shared/fairness lever -- see e5_adapter_baseline.json for the mirrored baseline sweep.",
  "base": {
    "model": "primary",
    "processed-dir": "outputs/processed_full",
    "features-dir": "outputs/features_full",
    "epochs": 30,
    "batch-size": 128,
    "num-workers": 0,
    "warmup-steps": 200,
    "early-stop-patience": 5,
    "min-epochs": 8,
    "save-best": true,
    "select-metric": "val_loss",
    "skip-test": true,
    "seed": 360,
    "dropout": 0.15,
    "weight-decay": 0.01,
    "n-compressed-tokens": 16,
    "pool": "last",
    "lr": 0.001,
    "word-dropout-prob": 0.15,
    "token-order": "question_first"
  },
  "runs": [
    {"run-name": "e5_primary_adapter_affine", "feature-adapter": "affine"},
    {"run-name": "e5_primary_adapter_conv1x1", "feature-adapter": "conv1x1"}
  ]
}
